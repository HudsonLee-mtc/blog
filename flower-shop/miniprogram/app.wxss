page {
  --bg: #eaf3ee;
  --surface: #f7fbf8;
  --ink: #1a2a22;
  --muted: #5f6f66;
  --brand: #2a5c45;
  --brand-soft: #d7ebe0;
  --accent: #b85c6a;
  --petal: #f3d6dc;
  --mist: #d9ebe3;
  --line: rgba(26, 42, 34, 0.08);
  --shadow: 0 20rpx 50rpx rgba(42, 92, 69, 0.1);
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
image,
button,
input,
textarea,
swiper,
scroll-view {
  box-sizing: border-box;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  overflow: hidden;
  background:
    radial-gradient(900rpx 520rpx at 8% -8%, rgba(243, 214, 220, 0.55), transparent 58%),
    radial-gradient(760rpx 480rpx at 100% 4%, rgba(42, 92, 69, 0.16), transparent 52%),
    radial-gradient(640rpx 420rpx at 70% 28%, rgba(217, 235, 227, 0.7), transparent 60%),
    linear-gradient(165deg, #eef7f2 0%, #e7f0ea 42%, #f4efe9 100%);
}

.page::before,
.page::after {
  content: '';
}

.brand {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--brand);
}

.slogan {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.section-title {
  margin: 36rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
}

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.product-card {
  background: rgba(247, 251, 248, 0.92);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  backdrop-filter: blur(8px);
}

.product-card .cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.product-card .body {
  padding: 18rpx 18rpx 22rpx;
}

.product-card .name {
  font-size: 28rpx;
  font-weight: 600;
}

.product-card .sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  margin-top: 12rpx;
  color: var(--accent);
  font-weight: 700;
  font-size: 30rpx;
}

.price .yen {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
}

.btn-ghost::after {
  border: none;
}

.muted {
  color: var(--muted);
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--muted);
}
