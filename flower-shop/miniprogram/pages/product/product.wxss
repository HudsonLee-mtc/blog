.product-page {
  padding-bottom: 160rpx;
}

.gallery {
  height: 720rpx;
  margin: -24rpx -28rpx 0;
  width: calc(100% + 56rpx);
}

.gallery-img {
  width: 100%;
  height: 720rpx;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}

.name {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  color: var(--muted);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 18rpx;
}

.origin {
  color: var(--muted);
  text-decoration: line-through;
  font-size: 24rpx;
}

.tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
}

.label {
  margin-top: 8rpx;
  margin-bottom: 14rpx;
  font-weight: 650;
}

.spec-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.spec {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f1ebe3;
  color: var(--ink);
  font-size: 24rpx;
}

.spec.on {
  background: var(--brand);
  color: #fff;
}

.qty-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1ebe3;
  text-align: center;
  line-height: 52rpx;
  font-size: 32rpx;
}

.qty {
  min-width: 40rpx;
  text-align: center;
  font-weight: 650;
}

.line {
  margin-bottom: 18rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 252, 248, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(28, 25, 22, 0.06);
}

.bottom-bar button {
  flex: 1;
}
