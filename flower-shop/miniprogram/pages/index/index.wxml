<view class="home-page">
  <view class="poster-wrap">
    <image class="poster" src="/assets/home-hero.png" mode="widthFix" />

    <!-- 透明热区：对应图上三个入口 + 盲盒推荐 -->
    <view
      class="hotspot hotspot-pickup"
      data-mode="pickup"
      data-path="/pages/service/service?mode=pickup"
      bindtap="onAction"
    ></view>
    <view
      class="hotspot hotspot-custom"
      data-mode="custom"
      data-path="/pages/custom/custom"
      bindtap="onAction"
    ></view>
    <view
      class="hotspot hotspot-delivery"
      data-mode="delivery"
      data-path="/pages/service/service?mode=delivery"
      bindtap="onAction"
    ></view>
    <view class="hotspot hotspot-promo" bindtap="goPromo"></view>
  </view>
</view>
