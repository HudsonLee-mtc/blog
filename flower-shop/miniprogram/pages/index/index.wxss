.hero {
  padding: 12rpx 4rpx 8rpx;
}

.notice {
  margin-top: 16rpx;
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 77, 58, 0.1);
  color: var(--brand);
  font-size: 22rpx;
}

.banner {
  margin-top: 28rpx;
  height: 360rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.banner-img {
  width: 100%;
  height: 360rpx;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx;
  background: linear-gradient(transparent, rgba(20, 30, 24, 0.72));
  color: #fff;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.scene-row {
  display: flex;
  white-space: nowrap;
  width: 100%;
}

.scene-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--brand);
  font-size: 24rpx;
  box-shadow: var(--shadow);
}
