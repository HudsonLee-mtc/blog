.home-page {
  padding-top: 12rpx;
}

.atmosphere {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 620rpx;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.atmosphere-img {
  width: 100%;
  height: 100%;
  filter: saturate(1.05) contrast(0.95);
  transform: scale(1.08);
  opacity: 0.42;
}

.atmosphere-wash {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(234, 243, 238, 0.28) 0%, rgba(234, 243, 238, 0.72) 58%, rgba(234, 243, 238, 1) 100%),
    radial-gradient(520rpx 280rpx at 18% 20%, rgba(243, 214, 220, 0.35), transparent 70%);
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
}

.orb-a {
  width: 220rpx;
  height: 220rpx;
  left: -40rpx;
  top: 120rpx;
  background: rgba(216, 235, 224, 0.55);
}

.orb-b {
  width: 180rpx;
  height: 180rpx;
  right: 24rpx;
  top: 48rpx;
  background: rgba(243, 214, 220, 0.42);
}

.orb-c {
  width: 140rpx;
  height: 140rpx;
  right: 180rpx;
  top: 260rpx;
  background: rgba(42, 92, 69, 0.12);
}

.hero,
.banner,
.section-title,
.scene-row,
.card-grid {
  position: relative;
  z-index: 1;
}

.hero {
  padding: 28rpx 8rpx 18rpx;
}

.brand-mark {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  letter-spacing: 10rpx;
  color: rgba(42, 92, 69, 0.72);
}

.hero .brand {
  font-size: 72rpx;
  letter-spacing: 10rpx;
  text-shadow: 0 10rpx 30rpx rgba(42, 92, 69, 0.12);
}

.hero .slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #3d5248;
}

.notice {
  margin-top: 20rpx;
  display: inline-block;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(247, 251, 248, 0.78);
  color: var(--brand);
  font-size: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(42, 92, 69, 0.08);
  backdrop-filter: blur(10px);
}

.banner {
  margin-top: 28rpx;
  height: 360rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.banner-img {
  width: 100%;
  height: 360rpx;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx;
  background: linear-gradient(transparent, rgba(18, 34, 27, 0.72));
  color: #fff;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.scene-row {
  display: flex;
  white-space: nowrap;
  width: 100%;
}

.scene-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(247, 251, 248, 0.9);
  color: var(--brand);
  font-size: 24rpx;
  box-shadow: var(--shadow);
  backdrop-filter: blur(8px);
}
