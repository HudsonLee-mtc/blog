.balance-card {
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(42, 92, 69, 0.95), rgba(42, 92, 69, 0.75)),
    radial-gradient(420rpx 220rpx at 90% 10%, rgba(243, 214, 220, 0.35), transparent 70%);
  color: #fff;
  box-shadow: var(--shadow);
}

.balance-card .label {
  opacity: 0.85;
  font-size: 24rpx;
}

.balance {
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 700;
}

.balance .yen {
  font-size: 32rpx;
  margin-right: 4rpx;
}

.tip {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78) !important;
  font-size: 22rpx;
}

.pack-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.pack {
  padding: 28rpx 22rpx;
  border-radius: 22rpx;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.pack.on {
  outline: 3rpx solid var(--brand);
  background: var(--brand-soft);
}

.pack-label {
  font-weight: 700;
  font-size: 28rpx;
}

.pack-bonus {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 22rpx;
}

.pack-amount {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}
