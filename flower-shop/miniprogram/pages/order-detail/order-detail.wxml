<view class="page" wx:if="{{order}}">
  <view class="panel status-panel">
    <view class="status">{{statusText[order.status] || order.status}}</view>
    <view class="muted">订单号 {{order.orderNo}}</view>
  </view>

  <view class="panel">
    <view class="panel-title">配送信息</view>
    <view>{{order.address.name}} {{order.address.phone}}</view>
    <view class="muted">{{order.address.detail}}</view>
    <view class="muted">{{order.deliveryDate}} {{order.deliverySlot}}</view>
    <view class="muted" wx:if="{{order.cardMessage}}">贺卡：{{order.cardMessage}}</view>
  </view>

  <view class="panel">
    <view class="panel-title">商品</view>
    <view class="goods" wx:for="{{order.items}}" wx:key="specId">
      <image src="{{item.cover}}" mode="aspectFill" />
      <view class="g-meta">
        <view>{{item.productName}}</view>
        <view class="muted">{{item.specName}} × {{item.quantity}}</view>
      </view>
      <view>¥{{item.price}}</view>
    </view>
    <view class="sum"><text>合计</text><text class="accent">¥{{order.totalAmount}}</text></view>
  </view>

  <button
    wx:if="{{order.status === 'pending_pay'}}"
    class="btn-primary"
    bindtap="pay"
    loading="{{paying}}"
  >模拟支付</button>
</view>
