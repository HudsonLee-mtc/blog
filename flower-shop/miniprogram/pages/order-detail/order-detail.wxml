<view class="page" wx:if="{{order}}">
  <view class="panel status-panel">
    <view class="status">{{statusText[order.status] || order.status}}</view>
    <view class="muted">订单号 {{order.orderNo}}</view>
    <view class="muted">{{fulfillmentText}}</view>
  </view>

  <view class="panel">
    <view class="panel-title">{{order.fulfillmentType === 'pickup' ? '到店信息' : '配送信息'}}</view>
    <view>{{order.address.name}} {{order.address.phone}}</view>
    <view class="muted">{{order.address.detail}}</view>
    <view class="muted">{{order.deliveryDate}} {{order.deliverySlot}}</view>
    <view class="muted" wx:if="{{order.cardMessage}}">贺卡：{{order.cardMessage}}</view>
    <view class="muted" wx:if="{{order.remark}}">备注：{{order.remark}}</view>
  </view>

  <view class="panel">
    <view class="panel-title">商品</view>
    <view class="goods" wx:for="{{order.items}}" wx:key="specId">
      <image src="{{item.cover}}" mode="aspectFill" />
      <view class="g-meta">
        <view>{{item.productName}}</view>
        <view class="muted">{{item.specName}} × {{item.quantity}}</view>
        <view class="muted" wx:if="{{item.optionNames.length}}">定制：{{item.optionNames}}</view>
      </view>
      <view>¥{{item.price * item.quantity}}</view>
    </view>
    <view class="sum muted"><text>商品</text><text>¥{{order.goodsAmount}}</text></view>
    <view class="sum muted"><text>配送费</text><text>¥{{order.deliveryFee}}</text></view>
    <view class="sum"><text>合计</text><text class="accent">¥{{order.totalAmount}}</text></view>
  </view>

  <block wx:if="{{order.status === 'pending_pay'}}">
    <view class="panel pay-panel">
      <view class="panel-title">支付方式</view>
      <view class="muted">当前余额 ¥{{walletBalance}}</view>
      <view class="link" bindtap="goWallet">去充值</view>
    </view>
    <button
      class="btn-primary"
      data-method="wallet"
      bindtap="pay"
      loading="{{paying}}"
    >余额支付 ¥{{order.totalAmount}}</button>
    <button
      class="btn-ghost mock-pay"
      data-method="mock"
      bindtap="pay"
      loading="{{paying}}"
    >模拟微信支付</button>
  </block>
</view>
