.panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
}

.panel-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

.remark-title {
  margin-top: 20rpx;
}

.field {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 14rpx;
  background: #f4efe8;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 20rpx;
  background: #f4efe8;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.picker-row {
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  background: #f4efe8;
  border-radius: 16rpx;
}

.slot-row {
  display: flex;
  white-space: nowrap;
}

.slot {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f4efe8;
  font-size: 24rpx;
}

.slot.on {
  background: var(--brand);
  color: #fff;
}

.line-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.line-item image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
}

.line-item .meta {
  flex: 1;
  min-width: 0;
}

.line-item .amount {
  font-weight: 650;
}

.sum-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: var(--muted);
}

.sum-row.total {
  margin-top: 16rpx;
  color: var(--ink);
  font-weight: 700;
  font-size: 30rpx;
}

.accent {
  color: var(--accent);
}

.submit {
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

.mode-row {
  display: flex;
  gap: 16rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 18rpx;
  background: #eef5f1;
  font-weight: 650;
}

.mode.on {
  background: var(--brand);
  color: #fff;
}

.panel-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-title-row .panel-title {
  margin-bottom: 0;
}

.link {
  color: var(--brand);
  font-size: 24rpx;
}

.address-card {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef5f1;
}

.shop-box {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef5f1;
  line-height: 1.7;
}

.map-tip {
  margin-top: 10rpx;
}

.wallet-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}
