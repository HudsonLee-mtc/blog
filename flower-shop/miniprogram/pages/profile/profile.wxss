.profile-page .hero {
  position: relative;
  padding: 48rpx 12rpx 36rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background:
    radial-gradient(420rpx 220rpx at 90% 10%, rgba(243, 214, 220, 0.45), transparent 70%),
    linear-gradient(135deg, rgba(215, 235, 224, 0.95), rgba(247, 251, 248, 0.92));
  box-shadow: var(--shadow);
}

.profile-page .brand {
  letter-spacing: 8rpx;
}

.wallet-entry {
  margin-top: 24rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(42, 92, 69, 0.95), rgba(42, 92, 69, 0.72));
  color: #fff;
  box-shadow: var(--shadow);
}

.wallet-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.wallet-balance {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.wallet-balance .yen {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.wallet-cta {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.menu {
  margin-top: 24rpx;
  background: rgba(247, 251, 248, 0.92);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  backdrop-filter: blur(8px);
}

.menu-item {
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(26, 42, 34, 0.06);
  font-weight: 600;
}

.menu-item:last-child {
  border-bottom: none;
}

.shop-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: rgba(247, 251, 248, 0.92);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
}

.shop-title {
  font-weight: 700;
  margin-bottom: 12rpx;
}

.shop-name {
  font-weight: 650;
  margin-bottom: 6rpx;
}

.shop-phone {
  margin-top: 14rpx;
  color: var(--brand);
  font-weight: 600;
}

.tips {
  margin-top: 36rpx;
  font-size: 24rpx;
  line-height: 1.7;
}
