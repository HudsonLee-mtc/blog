.profile-page .hero {
  position: relative;
  padding: 48rpx 12rpx 36rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background:
    radial-gradient(420rpx 220rpx at 90% 10%, rgba(243, 214, 220, 0.45), transparent 70%),
    linear-gradient(135deg, rgba(215, 235, 224, 0.95), rgba(247, 251, 248, 0.92));
  box-shadow: var(--shadow);
}

.profile-page .brand {
  letter-spacing: 8rpx;
}

.menu {
  margin-top: 24rpx;
  background: rgba(247, 251, 248, 0.92);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  backdrop-filter: blur(8px);
}

.menu-item {
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(26, 42, 34, 0.06);
  font-weight: 600;
}

.menu-item:last-child {
  border-bottom: none;
}

.tips {
  margin-top: 36rpx;
  font-size: 24rpx;
  line-height: 1.7;
}
