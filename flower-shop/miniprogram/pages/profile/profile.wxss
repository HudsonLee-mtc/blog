.profile-page .hero {
  padding: 40rpx 12rpx 28rpx;
}

.menu {
  margin-top: 12rpx;
  background: var(--surface);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.menu-item {
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(28, 25, 22, 0.06);
  font-weight: 600;
}

.menu-item:last-child {
  border-bottom: none;
}

.tips {
  margin-top: 36rpx;
  font-size: 24rpx;
  line-height: 1.7;
}
