.addr-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
}

.addr-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.name {
  font-weight: 700;
  font-size: 30rpx;
}

.phone {
  color: var(--muted);
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
}

.detail {
  margin-top: 12rpx;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.action {
  color: var(--brand);
  font-size: 24rpx;
}

.action.danger {
  color: var(--accent);
}

.add-btn {
  margin-top: 28rpx;
}

.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
}
