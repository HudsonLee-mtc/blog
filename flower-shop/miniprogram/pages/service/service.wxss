.service-page {
  padding-bottom: 48rpx;
}

.hero-card {
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(215, 235, 224, 0.95), rgba(247, 251, 248, 0.92));
  box-shadow: var(--shadow);
}

.mode-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(42, 92, 69, 0.12);
  color: var(--brand);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.desc {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(247, 251, 248, 0.95);
  box-shadow: var(--shadow);
}

.panel-title {
  font-weight: 700;
  margin-bottom: 14rpx;
}

.shop-name {
  font-weight: 650;
  margin-bottom: 8rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin: 0;
}

.main-cta {
  margin-top: 36rpx;
}
