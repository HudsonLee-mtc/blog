.intro {
  padding: 28rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(243, 214, 220, 0.35), rgba(215, 235, 224, 0.9));
  box-shadow: var(--shadow);
}

.intro .title {
  font-size: 40rpx;
  font-weight: 700;
}

.intro .desc {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(247, 251, 248, 0.95);
  box-shadow: var(--shadow);
}

.panel-title {
  font-weight: 700;
  margin-bottom: 12rpx;
}

.option {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.option:last-child {
  border-bottom: none;
}

.option-name {
  font-weight: 650;
}

.option-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.option-price {
  color: var(--accent);
  font-weight: 700;
  white-space: nowrap;
}
